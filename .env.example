# Copy to .env on your own server. Never commit real secrets.
M1_AUTH_SECRET=
M1_AUTH_TOKEN_MINUTES=30
M1_SITE_ADDRESS=http://localhost
M1_LOGIN_RATE_PER_MINUTE=10
M1_API_RATE_PER_MINUTE=120
M1_MAX_BODY_BYTES=65536
TRADINGVIEW_WEBHOOK_SECRET=
# Optional TESTNET credentials only. No real trading or withdrawal capability.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
# Virtual cash-only PAPER simulation. These are assumptions, not exchange fees.
M1_PAPER_INITIAL_CASH=10000
M1_PAPER_FEE_BPS=10
M1_PAPER_MAX_NOTIONAL=1000
M1_PAPER_MAX_TRADE_RISK_PCT=1
M1_PAPER_MAX_OPEN_RISK_PCT=3
M1_PAPER_MAX_DAILY_LOSS_PCT=5

# Host path to a protected file outside the repository; contents are base64 of 32 random bytes.
M1_TESTNET_ENCRYPTION_KEY_FILE=
