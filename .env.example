# Template only. Copy to an untracked .env on the staging host and set values locally.
# Never commit a populated .env or real secrets.
M1_AUTH_SECRET=
M1_AUTH_TOKEN_MINUTES=30
# Bare public DNS hostname only; do not include http:// or https://
M1_SITE_ADDRESS=staging.example.com
M1_ADMIN_USERNAME=staging-admin
M1_ADMIN_PASSWORD_HASH=
M1_LOGIN_RATE_PER_MINUTE=10
M1_API_RATE_PER_MINUTE=120
M1_MAX_BODY_BYTES=65536
M1_CORS_ORIGINS=
TRADINGVIEW_WEBHOOK_SECRET=
# Do not set these in staging. Enter Spot Testnet credentials only in the authenticated admin UI.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000
# Virtual cash-only PAPER simulation. These are assumptions, not exchange fees.
M1_PAPER_INITIAL_CASH=10000
M1_PAPER_FEE_BPS=10
M1_PAPER_MAX_NOTIONAL=1000
M1_PAPER_MAX_TRADE_RISK_PCT=1
M1_PAPER_MAX_OPEN_RISK_PCT=3
M1_PAPER_MAX_DAILY_LOSS_PCT=5

# Absolute host path to a protected file outside the repository; contents are Base64 of 32 random bytes.
M1_TESTNET_ENCRYPTION_KEY_FILE=
# Intentionally unset in staging preparation:
# M1_TESTNET_ORDER_SUBMISSION_ENABLED=false
